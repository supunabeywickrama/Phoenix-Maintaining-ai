# ============================================
# Phoenix Industries — Maintenance Copilot
# Copy to .env and fill in. Never commit .env
# ============================================

# ── AI provider (Qwen via Alibaba Cloud Model Studio / DashScope) ─────────────
# OpenAI-compatible endpoint. Use the Singapore region for the free trial quota.
# Get a key: https://modelstudio.console.alibabacloud.com/
AI_API_KEY=sk-your-dashscope-key
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_CHAT=qwen-max
MODEL_CHAT_LIGHT=qwen-flash
MODEL_VISION=qwen-vl-max
MODEL_EMBEDDING=text-embedding-v4
EMBEDDING_DIM=2048

# ── Database (Postgres + pgvector) ───────────────────────────────────────────
# MUST be a Phoenix-only database, not the Zynaptrix one. Neon's free plan
# allows many projects: https://neon.tech
DATABASE_URL=postgresql://user:password@host/phoenix?sslmode=require

# ── Object storage (manual PDFs and extracted figures) ───────────────────────
# Blobs are namespaced under a "phoenix/" folder prefix.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Service URLs ─────────────────────────────────────────────────────────────
# FRONTEND_URL is the single allowed CORS origin — it must match where the UI
# actually runs, or the browser will block every request.
API_URL=http://127.0.0.1:8100
FRONTEND_URL=http://localhost:3100

LOG_LEVEL=INFO
